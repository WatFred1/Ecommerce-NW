# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:1234@localhost:5432/econmerce?schema=public"

# Obligatorio si se habilita autenticación. Mínimo 32 caracteres.
JWT_SECRET=cambia-este-valor-por-uno-de-32-caracteres-o-mas

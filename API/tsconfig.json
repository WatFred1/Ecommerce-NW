
{
"compilerOptions": {
"target": "ES2023", 
"module": "esnext",
"moduleResolution": "bundler",
"rootDir": ".",
"outDir": "./dist", 
"strict": true,
"esModuleInterop": true,
"skipLibCheck": true,
"resolveJsonModule": true, 
"forceConsistentCasingInFileNames": true,
"types": ["node"],
"sourceMap": true
},
"include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma.config.ts"
],
"exclude": [
    "node_modules",
     "dist"]
}
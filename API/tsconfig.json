
{
"compilerOptions": {
"target": "ES2023", 
"module": "NodeNext",
"moduleResolution": "NodeNext", "rootDir": ".",
"outDir": "./dist", "strict": true,
"esModuleInterop": true, "skipLibCheck": true,
"resolveJsonModule": true, "types": ["node"],
"sourceMap": true
},
"include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma7.config.ts"
],
"exclude": [
    "node_modules",
     "dist"]
}